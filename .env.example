# ---------------------------------------------------------------------------
# SchoonmaakKlaar — environment variables
#
# Kopieer dit bestand naar .env.local voor lokale ontwikkeling.
# Zet de echte waarden in Vercel onder Settings → Environment Variables en
# kies daar per variabele bewust het bereik: Development / Preview / Production.
#
# Dit bestand bevat NOOIT echte secrets.
#
# Overzicht van het bereik per variabele:
#
#   Variabele                      Production   Preview      Geheim
#   -----------------------------  -----------  -----------  ------
#   NEXT_PUBLIC_SITE_URL           verplicht    niet zetten  nee
#   NEXT_PUBLIC_CONTACT_PHONE      zelfde       zelfde       nee
#   NEXT_PUBLIC_WHATSAPP_NUMBER    zelfde       zelfde       nee
#   NEXT_PUBLIC_CONTACT_EMAIL      zelfde       zelfde       nee
#   NEXT_PUBLIC_COMPANY_NUMBER     zelfde       zelfde       nee
#   NEXT_PUBLIC_COMPANY_VAT        zelfde       zelfde       nee
#   RESEND_API_KEY                 verplicht    verplicht    JA
#   RESEND_FROM_EMAIL              verplicht    zelfde       nee
#   FORM_TO_EMAIL                  verplicht    testpostvak  nee
#   NEXT_PUBLIC_GTAG_ID            indien nodig niet zetten  nee
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonieke basis-URL, zonder slash op het einde.
#
# Production: https://schoonmaakklaar.be
# Preview:    NIET zetten. De code valt dan terug op de productie-URL, zodat
#             preview-deployments canonicals naar het echte domein sturen en
#             niet zelf geïndexeerd raken. Zet daarnaast in Vercel onder
#             Settings → Deployment Protection de previews op beschermd.
NEXT_PUBLIC_SITE_URL=https://schoonmaakklaar.be

# --- Contactgegevens (publiek zichtbaar op de site) ------------------------
# Zolang een waarde leeg is, verbergt de site de bijbehorende knop of regel.
# In Production en Preview dezelfde waarden gebruiken, zodat een preview
# toont wat er live komt.
#
# Telefoon zoals u die wilt tonen, bv. "+32 470 00 00 00".
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp in internationaal formaat zonder plus of spaties, bv. "32470000000".
NEXT_PUBLIC_WHATSAPP_NUMBER=
# E-mailadres dat op de site getoond wordt.
NEXT_PUBLIC_CONTACT_EMAIL=
# Ondernemingsnummer, bv. "0XXX.XXX.XXX".
NEXT_PUBLIC_COMPANY_NUMBER=
# BTW-nummer, bv. "BE0XXXXXXXXX".
NEXT_PUBLIC_COMPANY_VAT=

# --- Offerteformulier via Resend -------------------------------------------
# API-sleutel van Resend. Server-side; nooit met NEXT_PUBLIC_ prefix en nooit
# in de repository. In Vercel toevoegen als Sensitive / geheime variabele.
# Production en Preview hebben beide een sleutel nodig, anders kan het
# formulier in een preview niet getest worden.
RESEND_API_KEY=
# Afzender op een in Resend geverifieerd domein, bv.
# "SchoonmaakKlaar <offerte@schoonmaakklaar.be>".
RESEND_FROM_EMAIL=
# Postvak waar de offerteaanvragen binnenkomen.
# Production: het echte postvak. Preview: liefst een testpostvak, zodat
# proefaanvragen niet tussen echte leads belanden.
FORM_TO_EMAIL=

# --- Analytics -------------------------------------------------------------
# Google tag (gtag.js), bv. "G-XXXXXXXXXX" of "AW-XXXXXXXXX".
# Enkel in Production zetten; leeg laten betekent geen tracking.
NEXT_PUBLIC_GTAG_ID=
